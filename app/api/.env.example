# Local development settings. Copy to .env (which is gitignored):  cp .env.example .env
# These credentials only work against the local Postgres in ../../compose.yaml.
# In GKE there is no .env file; values come from real environment variables.

# "+psycopg" tells SQLAlchemy to use the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://exitticket:localdev@localhost:5432/exitticket
LOG_LEVEL=INFO
ENVIRONMENT=local

# Signs sign-in tokens: anyone who has it can sign in as anyone. At least 32 characters.
# Make your own random one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-the-output-of-the-command-above
# The shared teacher passcode (at least 8 characters). Pick your own.
TEACHER_PASSCODE=replace-me
