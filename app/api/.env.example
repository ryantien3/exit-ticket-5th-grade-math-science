# Local development settings. Copy to .env (which is gitignored):  cp .env.example .env
# These credentials only work against the local Postgres in ../../compose.yaml.
# In GKE there is no .env file; values come from real environment variables.

# "+psycopg" tells SQLAlchemy to use the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://exitticket:localdev@localhost:5432/exitticket
LOG_LEVEL=INFO
ENVIRONMENT=local
